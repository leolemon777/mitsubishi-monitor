<Application x:Class="MitsubishiMonitor.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MitsubishiMonitor.Demo.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <!-- 主色调 -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#00BCD4" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#00C853" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFAB00" />
            <SolidColorBrush x:Key="DangerBrush" Color="#D32F2F" />

            <!-- 背景色 -->
            <SolidColorBrush x:Key="MaterialDesignBackground" Color="#1E1E1E" />
            <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="#2D2D2D" />
            <SolidColorBrush x:Key="MaterialDesignPaper" Color="#252525" />

            <!-- 文字颜色 -->
            <SolidColorBrush x:Key="MaterialDesignBody" Color="#E0E0E0" />
            <SolidColorBrush x:Key="MaterialDesignBodyLight" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MaterialDesignBodyHighEmphasis" Color="#B0B0B0" />

            <!-- 全局样式 -->
            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                <Setter Property="Foreground" Value="#E0E0E0" />
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                <Setter Property="Foreground" Value="#E0E0E0" />
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                <Setter Property="Foreground" Value="#E0E0E0" />
                <Setter Property="Background" Value="#3D3D3D" />
                <Setter Property="BorderBrush" Value="#505050" />
                <Setter Property="Padding" Value="8,6" />
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter x:Name="contentPresenter"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#00ACC8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0097A7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
