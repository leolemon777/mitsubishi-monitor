<Window x:Class="MitsubishiMonitor.Demo.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置"
        Width="580" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0A0E17"
        FontFamily="Microsoft Yahei UI"
        TextElement.Foreground="#E0E0E0"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- 输入框样式 -->
        <Style x:Key="TechTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0D1520"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#1E2D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="CaretBrush" Value="#00D4FF"/>
            <Setter Property="SelectionBrush" Value="#1A4A6A"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Microsoft Yahei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="#00D4FF" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00BBEE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0099CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft Yahei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="#0D1520" BorderBrush="#1E2D3D" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem样式 -->
        <Style x:Key="TechComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0D1520"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A4A6A"/>
                                <Setter Property="Foreground" Value="#00D4FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A4A6A"/>
                                <Setter Property="Foreground" Value="#00D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox样式 -->
        <Style x:Key="TechComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0D1520"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#1E2D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource TechComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Background="{TemplateBinding Background}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <Path x:Name="Arrow" Fill="#5A6B7C" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#00D4FF"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#00D4FF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#00D4FF"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#00D4FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="#0D1520" BorderThickness="1" BorderBrush="#00D4FF" CornerRadius="4" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,0">
                                    <ScrollViewer Margin="0,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="#0D1520" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0">
                <TextBlock Text="⚙" FontSize="14" Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="系统设置" FontSize="14" FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1" Content="✕" Width="46" Height="48" Background="Transparent"
                    Foreground="#5A6B7C" Click="Close_Click" FontSize="12"
                    Cursor="Hand" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" Width="46" Height="48">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF4444"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- 设置内容 -->
        <StackPanel Grid.Row="1" Margin="24,20,24,0">

            <!-- 数据库存储路径 -->
            <TextBlock Text="数据库存储路径" FontSize="12" Foreground="#5A6B7C" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DbPathTextBox"
                         Grid.Column="0"
                         Style="{StaticResource TechTextBoxStyle}"
                         ToolTip="填写数据库文件完整路径，例如 E:\MonitorData\Monitor.db&#10;留空则使用程序目录下的 Data\Monitor.db"/>
                <Button Grid.Column="1" Content="  浏览...  " Margin="8,0,0,0"
                        Click="BrowseFolder_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        FontSize="12" Padding="14,8"
                        Foreground="#00D4FF"/>
            </Grid>

            <TextBlock x:Name="HintText" FontSize="11" Foreground="#3A4B5C"
                       Margin="0,8,0,0"
                       Text="💡 留空使用默认路径（程序目录 Data\Monitor.db）；修改后需重启程序生效"/>

            <!-- 当前生效路径提示 -->
            <Border Background="#0D1520" BorderBrush="#1E2D3D" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="当前路径：" FontSize="11" Foreground="#4A5568" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CurrentPathText" FontSize="11" Foreground="#00D4FF"
                               FontFamily="Consolas" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 自动导出文件夹 -->
            <TextBlock Text="自动导出文件夹（HTML）" FontSize="12" Foreground="#5A6B7C" Margin="0,20,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AutoExportPathTextBox"
                         Grid.Column="0"
                         Style="{StaticResource TechTextBoxStyle}"
                         ToolTip="每次有数据变化时，自动追加写入该文件夹下的当日 HTML 文件&#10;留空则不导出"/>
                <Button Grid.Column="1" Content="  浏览...  " Margin="8,0,0,0"
                        Click="BrowseAutoExportFolder_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        FontSize="12" Padding="14,8"
                        Foreground="#00D4FF"/>
            </Grid>
            <TextBlock FontSize="11" Foreground="#3A4B5C" Margin="0,8,0,0"
                       Text="💡 每次IO点变化/温度采集时自动追加写入，用浏览器打开即可查看；留空不导出，无需重启生效"/>

            <!-- 三色灯诊断 -->
            <TextBlock Text="USB 三色灯" FontSize="12" Foreground="#5A6B7C" Margin="0,20,0,8"/>
            <Border Background="#0D1520" BorderBrush="#1E2D3D" BorderThickness="1"
                    CornerRadius="4" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 识别状态行 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="TowerLightDot" Width="10" Height="10"
                                 Fill="#3A4B5C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TowerLightStatusText" Grid.Column="1"
                                   Text="点击&quot;检测&quot;扫描 USB 三色灯"
                                   FontSize="12" Foreground="#5A6B7C"
                                   FontFamily="Consolas" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" x:Name="ScanTowerLightButton"
                                Content="  检 测  " Click="ScanTowerLight_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11" Padding="10,6" Foreground="#00D4FF"/>
                    </Grid>

                    <!-- 所有COM口列表 -->
                    <TextBlock x:Name="AllPortsText" Grid.Row="1"
                               FontSize="11" Foreground="#3A4B5C" FontFamily="Consolas"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="当前系统 COM 口：（未扫描）"/>

                    <!-- 手动选择COM口行（自动识别失败时使用） -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="手动选口：" FontSize="11" Foreground="#4A5568"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ManualPortComboBox" Grid.Column="1"
                                  Style="{StaticResource TechComboBoxStyle}"
                                  FontFamily="Consolas" FontSize="12"
                                  VerticalAlignment="Center"
                                  ToolTip="自动识别失败时，从此处选择 COM 口手动测试" />
                        <Button Grid.Column="2" x:Name="ManualTestButton"
                                Content="  手动测试  " Click="ManualTest_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11" Padding="10,6" Foreground="#F0C040"
                                Margin="8,0,0,0" IsEnabled="False"/>
                    </Grid>

                    <!-- 测试按钮行 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="TestTowerLightButton"
                                Content="  点灯测试（红→黄→绿）  "
                                Click="TestTowerLight_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11" Padding="10,6" Foreground="#F0C040"
                                IsEnabled="False"/>
                        <Button x:Name="InstallDriverButton"
                                Content="  📦 安装 CH340 驱动  "
                                Click="InstallDriver_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11" Padding="10,6" Foreground="#FF8800"
                                Visibility="Collapsed" Margin="8,0,0,0"/>
                        <TextBlock x:Name="TestResultText"
                                   FontSize="11" Foreground="#5A6B7C"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" BorderBrush="#1E2D3D" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：打开诊断日志文件夹（运维排查 UI 卡死时用） -->
                <Button Grid.Column="0" x:Name="OpenLogFolderButton"
                        Content="  📂 打开日志文件夹  "
                        Style="{StaticResource SecondaryButtonStyle}"
                        Foreground="#5A8FB8" FontSize="11"
                        Click="OpenLogFolder_Click"
                        ToolTip="打开诊断日志所在的目录，UI 卡死时把里面的 diagnostic-*.log 发给开发即可定位"/>

                <!-- 右侧：保存/取消 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取 消" Style="{StaticResource SecondaryButtonStyle}"
                            Foreground="#5A6B7C" Click="Cancel_Click" Margin="0,0,12,0"/>
                    <Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryButtonStyle}"
                            Foreground="#0A0E17" FontWeight="SemiBold" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
