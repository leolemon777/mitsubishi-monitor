<Window x:Class="MitsubishiMonitor.Demo.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置"
        Width="580" Height="280"
        WindowStartupLocation="CenterOwner"
        Background="#0A0E17"
        FontFamily="Microsoft Yahei UI"
        TextElement.Foreground="#E0E0E0"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- 输入框样式 -->
        <Style x:Key="TechTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0D1520"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#1E2D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="CaretBrush" Value="#00D4FF"/>
            <Setter Property="SelectionBrush" Value="#1A4A6A"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Microsoft Yahei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="#00D4FF" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00BBEE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0099CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft Yahei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="#0D1520" BorderBrush="#1E2D3D" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="#0D1520" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0">
                <TextBlock Text="⚙" FontSize="14" Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="系统设置" FontSize="14" FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1" Content="✕" Width="46" Height="48" Background="Transparent"
                    Foreground="#5A6B7C" Click="Close_Click" FontSize="12"
                    Cursor="Hand" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" Width="46" Height="48">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF4444"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- 设置内容 -->
        <StackPanel Grid.Row="1" Margin="24,20,24,0">

            <!-- 数据库存储路径 -->
            <TextBlock Text="数据库存储路径" FontSize="12" Foreground="#5A6B7C" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DbPathTextBox"
                         Grid.Column="0"
                         Style="{StaticResource TechTextBoxStyle}"
                         ToolTip="填写数据库文件完整路径，例如 E:\MonitorData\Monitor.db&#10;留空则使用程序目录下的 Data\Monitor.db"/>
                <Button Grid.Column="1" Content="  浏览...  " Margin="8,0,0,0"
                        Click="BrowseFolder_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        FontSize="12" Padding="14,8"
                        Foreground="#00D4FF"/>
            </Grid>

            <TextBlock x:Name="HintText" FontSize="11" Foreground="#3A4B5C"
                       Margin="0,8,0,0"
                       Text="💡 留空使用默认路径（程序目录 Data\Monitor.db）；修改后需重启程序生效"/>

            <!-- 当前生效路径提示 -->
            <Border Background="#0D1520" BorderBrush="#1E2D3D" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="当前路径：" FontSize="11" Foreground="#4A5568" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CurrentPathText" FontSize="11" Foreground="#00D4FF"
                               FontFamily="Consolas" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" BorderBrush="#1E2D3D" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取 消" Style="{StaticResource SecondaryButtonStyle}"
                        Foreground="#5A6B7C" Click="Cancel_Click" Margin="0,0,12,0"/>
                <Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryButtonStyle}"
                        Foreground="#0A0E17" FontWeight="SemiBold" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
