<Window x:Class="MitsubishiMonitor.Demo.Views.ExportConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MitsubishiMonitor.Demo.Converters"
        Title="数据导出配置"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="#0A0E17"
        FontFamily="Microsoft Yahei UI"
        TextElement.Foreground="#E0E0E0"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8892B0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="#0D1520"/>
            <Setter Property="BorderBrush" Value="#1E2D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="📤 数据导出配置" FontSize="18" FontWeight="Bold"
                   Foreground="#C9D1D9" Margin="0,0,0,16"/>

        <!-- 时间范围 -->
        <Border Grid.Row="1" Style="{StaticResource SectionBorder}">
            <StackPanel>
                <TextBlock Text="时间范围" Style="{StaticResource GroupTitle}"/>
                <StackPanel Orientation="Horizontal">
                    <DatePicker x:Name="StartDatePicker" Width="150" Margin="0,0,10,0"
                                Background="#161B22" Foreground="#C9D1D9"/>
                    <TextBlock Text="至" VerticalAlignment="Center" Foreground="#7D8590" Margin="0,0,10,0"/>
                    <DatePicker x:Name="EndDatePicker" Width="150"
                                Background="#161B22" Foreground="#C9D1D9"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 数据类型 -->
        <Border Grid.Row="2" Style="{StaticResource SectionBorder}">
            <StackPanel>
                <TextBlock Text="数据类型" Style="{StaticResource GroupTitle}"/>
                <WrapPanel>
                    <CheckBox x:Name="ChkTemp" Content="温度记录" IsChecked="True" Margin="0,0,16,4" Foreground="#C9D1D9"/>
                    <CheckBox x:Name="ChkOp" Content="操作日志" IsChecked="True" Margin="0,0,16,4" Foreground="#C9D1D9"/>
                    <CheckBox x:Name="ChkAlarm" Content="警报记录" Margin="0,0,16,4" Foreground="#C9D1D9"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 导出格式 -->
        <Border Grid.Row="3" Style="{StaticResource SectionBorder}">
            <StackPanel>
                <TextBlock Text="导出格式" Style="{StaticResource GroupTitle}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbExcel" Content="Excel (.xlsx)" IsChecked="True"
                                 Foreground="#C9D1D9" Margin="0,0,16,0" GroupName="Format"/>
                    <RadioButton x:Name="RbCsv" Content="CSV (.csv)"
                                 Foreground="#C9D1D9" Margin="0,0,16,0" GroupName="Format"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="取消" Width="90" Padding="0,8" Margin="0,0,10,0"
                    Background="#161B22" Foreground="#7D8590" BorderBrush="#30363D" BorderThickness="1"
                    Click="Cancel_Click"/>
            <Button Content="开始导出" Width="110" Padding="0,8"
                    Background="#238636" Foreground="White" BorderThickness="0"
                    Click="Export_Click"/>
        </StackPanel>
    </Grid>
</Window>
