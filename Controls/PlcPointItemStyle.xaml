<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MitsubishiMonitor.Demo.Controls">

    <Style TargetType="controls:PlcPointItem">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PlcPointItem">
                    <Border x:Name="RootBorder"
                            Background="#162436"
                            BorderBrush="#1E2D3D"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 地址 -->
                            <TextBlock Grid.Row="0"
                                       Text="{TemplateBinding Address}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#B0B0B0"
                                       HorizontalAlignment="Center"/>

                            <!-- 状态指示器 -->
                            <Ellipse Grid.Row="1"
                                     x:Name="StatusIndicator"
                                     Width="20"
                                     Height="20"
                                     Fill="{TemplateBinding OffColor}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Margin="0,4">
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="StatusShadow"
                                                      Color="Transparent"
                                                      BlurRadius="0"
                                                      ShadowDepth="0"
                                                      Opacity="0"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- 标签 -->
                            <TextBlock Grid.Row="2"
                                       Text="{TemplateBinding Label}"
                                       FontSize="9"
                                       Foreground="#808080"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="70"/>
                        </Grid>

                        <!-- 视觉状态管理 -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="States">
                                <!-- ON 状态 -->
                                <VisualState Name="OnState">
                                    <Storyboard>
                                        <!-- 背景高亮 -->
                                        <ColorAnimation Storyboard.TargetName="RootBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#1F3347"
                                                        Duration="0:0:0.2"/>
                                        
                                        <!-- 边框高亮 -->
                                        <ColorAnimation Storyboard.TargetName="RootBorder"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#4CAF50"
                                                        Duration="0:0:0.2"/>
                                        
                                        <!-- 指示器变色 -->
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StatusIndicator"
                                                                        Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OnColor}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        
                                        <!-- 阴影效果 -->
                                        <ColorAnimation Storyboard.TargetName="StatusShadow"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#4CAF50"
                                                        Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="StatusShadow"
                                                        Storyboard.TargetProperty="BlurRadius"
                                                        To="10"
                                                        Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="StatusShadow"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0.8"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>

                                <!-- OFF 状态 -->
                                <VisualState Name="OffState">
                                    <Storyboard>
                                        <!-- 背景恢复 -->
                                        <ColorAnimation Storyboard.TargetName="RootBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#162436"
                                                        Duration="0:0:0.2"/>
                                        
                                        <!-- 边框恢复 -->
                                        <ColorAnimation Storyboard.TargetName="RootBorder"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#1E2D3D"
                                                        Duration="0:0:0.2"/>
                                        
                                        <!-- 指示器变色 -->
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StatusIndicator"
                                                                        Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OffColor}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        
                                        <!-- 阴影消失 -->
                                        <DoubleAnimation Storyboard.TargetName="StatusShadow"
                                                        Storyboard.TargetProperty="BlurRadius"
                                                        To="0"
                                                        Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="StatusShadow"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
