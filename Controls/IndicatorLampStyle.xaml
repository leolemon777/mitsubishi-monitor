<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MitsubishiMonitor.Demo.Controls">

    <Style TargetType="controls:IndicatorLamp">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:IndicatorLamp">
                    <StackPanel x:Name="RootPanel" Margin="4">
                        <!-- 指示灯 -->
                        <Ellipse Width="{TemplateBinding LampSize}" 
                                 Height="{TemplateBinding LampSize}"
                                 x:Name="LampEllipse"
                                 Stroke="#505050"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Center">
                            <!-- 默认纯色填充 -->
                            <Ellipse.Fill>
                                <SolidColorBrush x:Name="LampBrush" Color="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OffColor}"/>
                            </Ellipse.Fill>
                            
                            <!-- 阴影效果 -->
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="LampShadow"
                                                  Color="#FFFFFF"
                                                  BlurRadius="0"
                                                  ShadowDepth="0"
                                                  Opacity="0"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- 标签 -->
                        <TextBlock Text="{TemplateBinding Label}"
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>

                        <!-- 视觉状态管理 -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="States">
                                <!-- 开启状态 -->
                                <VisualState Name="OnState">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="LampBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OnColor}"
                                                        Duration="0:0:0.2"/>
                                        <ColorAnimation Storyboard.TargetName="LampShadow"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OnColor}"
                                                        Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="LampShadow"
                                                        Storyboard.TargetProperty="BlurRadius"
                                                        To="20"
                                                        Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="LampShadow"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0.8"
                                                        Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="LampEllipse"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="1"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>

                                <!-- 关闭状态 -->
                                <VisualState Name="OffState">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="LampBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OffColor}"
                                                        Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="LampShadow"
                                                        Storyboard.TargetProperty="BlurRadius"
                                                        To="0"
                                                        Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="LampShadow"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0"
                                                        Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="LampEllipse"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0.5"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>

                                <!-- 警告状态（闪烁） -->
                                <VisualState Name="WarningState">
                                    <Storyboard RepeatBehavior="Forever">
                                        <!-- 颜色闪烁 -->
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="LampBrush"
                                                                       Storyboard.TargetProperty="Color">
                                            <LinearColorKeyFrame KeyTime="0:0:0" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=WarningColor}"/>
                                            <LinearColorKeyFrame KeyTime="0:0:0.5" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OffColor}"/>
                                            <LinearColorKeyFrame KeyTime="0:0:1" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=WarningColor}"/>
                                        </ColorAnimationUsingKeyFrames>
                                        
                                        <!-- 阴影闪烁 -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LampShadow"
                                                                        Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.9"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0.2"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.9"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LampShadow"
                                                                        Storyboard.TargetProperty="BlurRadius">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="25"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="10"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1" Value="25"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        
                                        <!-- 透明度闪烁 -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LampEllipse"
                                                                        Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0.6"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        
                                        <!-- 阴影颜色闪烁 -->
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="LampShadow"
                                                                       Storyboard.TargetProperty="Color">
                                            <LinearColorKeyFrame KeyTime="0:0:0" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=WarningColor}"/>
                                            <LinearColorKeyFrame KeyTime="0:0:0.5" Value="#808080"/>
                                            <LinearColorKeyFrame KeyTime="0:0:1" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=WarningColor}"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
