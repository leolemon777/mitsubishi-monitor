<UserControl x:Class="MitsubishiMonitor.Demo.Controls.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MitsubishiMonitor.Demo.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="400">
    
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        
        <!-- 科技感渐变画刷 -->
        <LinearGradientBrush x:Key="TechGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00D4FF" Offset="0"/>
            <GradientStop Color="#0099FF" Offset="0.5"/>
            <GradientStop Color="#0066FF" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>
    
    <Border x:Name="RootBorder"
            Background="#0D1520"
            BorderBrush="#1E2D3D"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Height="220"
            Cursor="Hand"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" Color="#000000" Opacity="0.3" BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        
        <Grid>
            <!-- 扫描线效果 -->
            <Border Height="2" VerticalAlignment="Top"
                    Background="{StaticResource TechGradient}" Opacity="0.3"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                               From="0" To="220" Duration="0:0:3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>

            <!-- 卡片边框装饰 -->
            <Border BorderBrush="{StaticResource TechGradient}" BorderThickness="0,0,0,2"
                    HorizontalAlignment="Left" Width="60" VerticalAlignment="Top" Height="2"/>

            <!-- 卡片内容 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 头部：设备名称 + 状态 + 连接按钮 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="11" Foreground="#4A5568" FontFamily="Consolas" Margin="0,0,0,2">UNIT</TextBlock>
                        <!-- 直接用 DataContext(Device)，避免 AncestorType=UserControl 解析到基类导致 DeviceName 依赖属性绑不上 -->
                        <TextBlock Text="{Binding Name}"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#E0E0E0" TextWrapping="Wrap" MaxWidth="220"/>
                        <TextBlock Text="{Binding Location}"
                                   FontSize="11" Foreground="#7D8590" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="220"/>
                    </StackPanel>

                    <!-- 连接/断开按钮 -->
                    <Button Grid.Column="1" Content="连接" FontSize="10" Padding="10,4" Margin="0,0,8,0"
                            Command="{Binding ConnectCommand}"
                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding IsOnline, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0D2D1A"/>
                                <Setter Property="Foreground" Value="#00FF88"/>
                                <Setter Property="BorderBrush" Value="#00AA55"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A4D2E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1" Content="断开" FontSize="10" Padding="10,4" Margin="0,0,8,0"
                            Command="{Binding DisconnectCommand}"
                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding IsOnline, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2D1A1A"/>
                                <Setter Property="Foreground" Value="#FF6B6B"/>
                                <Setter Property="BorderBrush" Value="#AA4444"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#4D2A2A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Border Grid.Column="2" CornerRadius="10" Padding="10,5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0D1520"/>
                                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Background" Value="#0D2D1A"/>
                                        <Setter Property="BorderBrush" Value="#00AA55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Fill" Value="#00FF88"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusDisplay}" FontSize="12" FontWeight="Medium" Foreground="#B0B0B0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 中部：数据展示 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 温度 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="10" Foreground="#4A5568" FontFamily="Consolas" Margin="0,0,0,4">TEMPERATURE</TextBlock>
                        <TextBlock Text="{Binding TemperatureDisplay}" FontSize="36" FontWeight="Light" FontFamily="Consolas">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#3A3A3A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Foreground" Value="#FFAA00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- 分隔线 -->
                    <Border Grid.Column="1" Background="#1E2D3D" Margin="8,0"/>

                    <!-- 操作次数 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock FontSize="10" Foreground="#4A5568" FontFamily="Consolas" Margin="0,0,0,4">OPERATIONS</TextBlock>
                        <TextBlock Text="{Binding TodayOperationCount}" FontSize="32" FontWeight="Light" FontFamily="Consolas">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#3A3A3A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Foreground" Value="#00D4FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- 底部：IP + 更新时间 -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock FontSize="10" Foreground="#3A4A5A" FontFamily="Consolas">
                            <Run Text="IP:"/><Run Text="{Binding IpAddress}" Foreground="#4A5568"/>
                        </TextBlock>
                        <TextBlock FontSize="10" Foreground="#3A4A5A" FontFamily="Consolas" Margin="16,0,0,0">
                            <Run Text="UPDATE:"/><Run Text="{Binding LastUpdateTime, StringFormat='{}{0:HH:mm:ss}'}" Foreground="#4A5568"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- 警告标识 -->
                    <Border Grid.Column="1" Background="#2D1A1A" BorderBrush="#FF4444" BorderThickness="1" CornerRadius="3" Padding="8,4"
                            Visibility="{Binding HasAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▲" FontSize="10" Foreground="#FF6B6B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="ALERT" FontSize="11" Foreground="#FF6B6B" FontWeight="SemiBold" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
