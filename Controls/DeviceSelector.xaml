<UserControl x:Class="MitsubishiMonitor.Demo.Controls.DeviceSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MitsubishiMonitor.Demo.Converters"
             mc:Ignorable="d"
             d:DesignHeight="44" d:DesignWidth="400">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="#0D1520" BorderBrush="#1E2D3D" BorderThickness="1" CornerRadius="6" Padding="8,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 当前设备 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#3FB950"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice.IsOnline, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Fill" Value="#484F58"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock FontSize="13" Foreground="#C9D1D9" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="未选择设备"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                    <Setter Property="Text" Value="未选择设备"/>
                                    <Setter Property="Foreground" Value="#484F58"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding SelectedDevice.Name, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="13" Foreground="#C9D1D9" VerticalAlignment="Center"
                           Visibility="{Binding SelectedDevice, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>

            <!-- 搜索框 -->
            <TextBox Grid.Column="1" Padding="8,4" FontSize="12"
                     Background="#161B22" Foreground="#C9D1D9" BorderBrush="#30363D"
                     Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="搜索设备..." Foreground="#484F58" Margin="8,4,0,0" FontSize="12"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- 分组筛选 -->
            <ComboBox Grid.Column="2" Width="100" Margin="8,0,0,0"
                      ItemsSource="{Binding Groups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      SelectedItem="{Binding SelectedGroup, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Background="#161B22" Foreground="#C9D1D9" BorderBrush="#30363D" FontSize="12"/>
        </Grid>
    </Border>
</UserControl>
