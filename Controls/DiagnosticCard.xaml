<UserControl x:Class="MitsubishiMonitor.Demo.Controls.DiagnosticCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="160" d:DesignWidth="280">

    <Border Background="#0D1520" BorderBrush="#1E2D3D" BorderThickness="1" CornerRadius="8" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="13" FontWeight="SemiBold" Foreground="#8892B0" Margin="0,0,0,10"/>

            <!-- 状态行 -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{Binding StatusIconColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="12" Foreground="#C9D1D9" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding TrendArrow, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="16" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{Binding TrendColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>

            <!-- 效率进度条 -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="效率" FontSize="11" Foreground="#7D8590" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="100"
                             Value="{Binding EfficiencyValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Background="#21262D" BorderThickness="0"
                             Foreground="{Binding EfficiencyColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBlock Grid.Column="2" FontSize="11" Foreground="#C9D1D9" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{Binding EfficiencyValue, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:F0}%}"/>
            </Grid>

            <!-- 详情按钮 -->
            <Button Grid.Row="3" Content="查看详情"
                    Command="{Binding ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    HorizontalAlignment="Right" Padding="10,4" FontSize="11"
                    Background="Transparent" Foreground="#58A6FF" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Border>
</UserControl>
