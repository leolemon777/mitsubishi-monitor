<UserControl x:Class="MitsubishiMonitor.Demo.Controls.ThresholdEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MitsubishiMonitor.Demo.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="300">
    
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- 警告渐变画刷 -->
        <LinearGradientBrush x:Key="AlertGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6B6B" Offset="0"/>
            <GradientStop Color="#FF4444" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>
    
    <Grid>
        <!-- 显示模式 -->
        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock FontSize="36" FontWeight="Bold" Foreground="#FF6B6B" FontFamily="Consolas" HorizontalAlignment="Center">
                <Run Text="{Binding Value, StringFormat={}{0:F1}}"/><Run Text="°C" FontSize="22"/>
            </TextBlock>
            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#7D8590" 
                       HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <Button Content="⚙️ 修改" Command="{Binding EditCommand}" 
                    Background="#0D1520" Foreground="#FF6B6B" BorderBrush="#FF4444" BorderThickness="1"
                    Padding="14,5" Margin="0,10,0,0" HorizontalAlignment="Center" Cursor="Hand" FontSize="12">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A0D0D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        
        <!-- 编辑模式 -->
        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
            <TextBlock Text="设置新阈值" FontSize="12" Foreground="#FF6B6B" FontWeight="SemiBold" 
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            
            <!-- 输入框 -->
            <TextBox x:Name="ValueTextBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" 
                     FontSize="24" FontWeight="Bold" FontFamily="Consolas"
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                     Background="#161B22" Foreground="#FF6B6B" BorderBrush="#FF4444" BorderThickness="1"
                     Padding="6" Height="42" Margin="0,0,0,10"
                     PreviewTextInput="ValueTextBox_PreviewTextInput"/>
            
            <!-- 按钮组 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="✓" Command="{Binding SaveCommand}"
                        Background="#238636" Foreground="White" BorderThickness="0"
                        Padding="16,6" Margin="0,0,6,0" Cursor="Hand" FontSize="12">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2EA043"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="✕" Command="{Binding CancelCommand}"
                        Background="#0D1520" Foreground="#7D8590" BorderBrush="#30363D" BorderThickness="1"
                        Padding="16,6" Cursor="Hand" FontSize="12">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#161B22"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
