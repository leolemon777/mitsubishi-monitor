<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.2.3</Version>
    <AssemblyVersion>1.2.3.0</AssemblyVersion>
    <FileVersion>1.2.3.0</FileVersion>
    <InformationalVersion>1.2.3-startup-config-fix.20260903</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 开发时复制到输出目录方便调试；发布包不携带（CopyToPublishDirectory=Never），
         避免把开发机的配置覆盖现场配置。程序启动时若无 config.json 会自动生成默认配置。 -->
    <None Include="config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <!-- 测试项目位于仓库子目录，主 WPF 项目不能把测试源文件重复编译进去。 -->
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- PLC通信库 -->
    <PackageReference Include="HslCommunication" Version="12.3.0" />

    <!-- 图表库 -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />

    <!-- 数据库 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <!-- 显式覆盖 EF Core 8 的旧传递依赖；2.1.13 携带已修复 CVE-2025-6965 的 SQLite。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- Excel导出：MIT 许可，避免把工业软件误标为“非商业用途”。 -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />

    <!-- MVVM框架 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- USB三色灯串口自动识别 -->
    <PackageReference Include="System.Management" Version="8.0.0" />

  </ItemGroup>

</Project>
