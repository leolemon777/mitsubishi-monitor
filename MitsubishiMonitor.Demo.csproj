<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0-communication-recovery.20260806</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 开发时复制到输出目录方便调试；发布包不携带（CopyToPublishDirectory=Never），
         避免把开发机的配置覆盖现场配置。程序启动时若无 config.json 会自动生成默认配置。 -->
    <None Include="config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <!-- 测试项目位于仓库子目录，主 WPF 项目不能把测试源文件重复编译进去。 -->
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- PLC通信库 -->
    <PackageReference Include="HslCommunication" Version="12.3.0" />

    <!-- 图表库 -->
    <PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />

    <!-- 数据库 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Excel导出 -->
    <PackageReference Include="EPPlus" Version="7.5.2" />

    <!-- MVVM框架 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- USB三色灯串口自动识别 -->
    <PackageReference Include="System.Management" Version="8.0.0" />

    <!-- 依赖注入 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

</Project>
